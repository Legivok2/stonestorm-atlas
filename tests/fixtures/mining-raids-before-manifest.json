{
  "manifest_version": 3,
  "name": "Stonestorm Stat Cap Overlay",
  "version": "0.9.9",
  "author": "Patrik",
  "description": "Készítette: Patrik. Stonestorm karakteradatok, felszerelés-bónuszok és statlimitek összehasonlítása.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://stonestorm.gg/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://stonestorm.gg/*"
      ],
      "js": [
        "pet-data.js",
        "pet-model.js",
        "equipment-model.js",
        "equipment-capture.js",
        "capture.js",
        "research-sanitizer.js",
        "research-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://stonestorm.gg/*"
      ],
      "js": [
        "pet-data.js",
        "pet-model.js",
        "research-sanitizer.js",
        "research-bridge.js",
        "research-ui.js",
        "research-overlay.js",
        "pet-source.js",
        "pet-tooltip.js",
        "equipment-model.js",
        "equipment-data.js",
        "equipment-storage.js",
        "equipment-switcher.js",
        "equipment-ui.js",
        "content.js",
        "home-expanded.js"
      ],
      "run_at": "document_idle",
      "css": [
        "home-expanded.css"
      ]
    }
  ],
  "action": {
    "default_title": "Atlas anonim export",
    "default_popup": "research-popup.html"
  }
}
