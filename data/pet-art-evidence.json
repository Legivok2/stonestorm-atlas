  "functions": {
    "Tl": {
      "sha256": "9cea00be0ebdb4d7e6f0d3b65c5e77d43927894075e3e25760c9bb322c084aa7",
      "source": "Tl={pet_u_wild:\"pet_fennec\",pet_u_monkey:\"pet_monkey\",pet_u_spider:\"pet_scarab\",pet_u_dragon:\"pet_salamander\"}"
    },
    "Ro": {
      "sha256": "3bf58011c1bb2646bc578cd027a3aadb60a1a98fd842397eb8bc5c8ae6ee975f",
      "source": "function Ro(e,t,n){if(n(`${e}_${t}`))return{name:`${e}_${t}`,framed:!1,any:!0};for(let o=t-1;o>=1;o--)if(n(`${e}_${o}`))return{name:`${e}_${o}`,framed:!0,any:!0};const s=[1,2,3,4,5].some(o=>n(`${e}_${o}`));return{name:`${e}_${Math.min(t,3)}`,framed:t>3,any:s}}"
    },
    "cT": {
      "sha256": "baa8040e687e4db7180f0b79302e6c4285ac30e52df709c26e2a2003d3101006",
      "source": "function cT(e,t,n){const s=Ro(e,t,n),o=Tl[e];return!s.any&&o?{name:Ro(o,t,n).name,framed:!0}:{name:s.name,framed:s.framed}}"
    }
  },
