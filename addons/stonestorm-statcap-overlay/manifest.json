{
  "manifest_version": 3,
  "name": "Stonestorm Stat Cap Overlay",
  "version": "0.9.3",
  "author": "Patrik",
  "description": "Készítette: Patrik. Stonestorm karakteradatok, felszerelés-bónuszok és statlimitek összehasonlítása.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://stonestorm.gg/*"],
  "content_scripts": [
    {
      "matches": ["https://stonestorm.gg/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://stonestorm.gg/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
