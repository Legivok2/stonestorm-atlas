  "locale": {
    "classes": {
      "warrior": {
        "name": "Harcos",
        "desc": "Két lábon járó faltörő kos egy ajtónyi kétkezes pallossal. Ha valami nem megy erőből, akkor még nagyobb erőből megy."
      },
      "ninja": {
        "name": "Nindzsa",
        "desc": "Gyorsabb, mint a falusi pletyka. Közelről két tőrrel szurkál, messziről íjjal lő, és utána senki nem látott semmit."
      },
      "mage_blade": {
        "name": "Mágus",
        "desc": "Lángoló kardot forgat, a pengéjében pedig egy morcos lángdémon lakik. A javasasszony szerint nem gond, amíg nem eteti.",
        "subtitle": "Pengemágus"
      },
      "shaman": {
        "name": "Sámán",
        "desc": "Legyezővel és egy marék talizmánnal villámot hív az égből, aztán bocsánatot kér a felhőktől. Nagyon udvarias, nagyon veszélyes."
      }
