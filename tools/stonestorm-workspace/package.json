  "license": "UNLICENSED",
  "description": "A native Electron workspace with normal-game and four-panel mining modes.",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:electron": "install-electron",
