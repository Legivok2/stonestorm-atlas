{
  "name": "stonestorm-atlas",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
    "build:data": "node scripts/build-data.mjs && python scripts/build-images.py",
    "build:images": "python scripts/build-images.py",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/home-observations.test.mjs tests/data-engine.test.mjs tests/atlas.test.mjs tests/publication.test.mjs tests/stat-limits.test.mjs tests/bonus-system.test.mjs tests/pet-system.test.mjs tests/addon.test.mjs tests/set-bonuses.test.mjs tests/atlas-sync.test.mjs tests/home-arena.test.mjs tests/addon-095.test.mjs tests/addon-pet-source.test.mjs && npm run test:addon:source",
    "build:addon": "node scripts/addon-package.mjs",
    "build:addon:pets": "node scripts/build-addon-pets.mjs",
    "refresh:addon:pets": "node scripts/build-addon-pets.mjs --refresh",
    "check:addon": "node scripts/addon-package.mjs --check",
    "test:addon:source": "node addons/stonestorm-statcap-overlay/tests/capture-refresh.test.js",
    "test:addon:browser": "node tests/addon-browser.mjs",
    "test:pets:browser": "node tests/pet-system-browser.mjs",
    "test:stats:browser": "node tests/stat-limits-browser.mjs",
    "test:dom": "node tests/dom-smoke.mjs && node tests/features-dom.mjs",
    "test:dom:guide": "node tests/guide-dom.mjs",
    "test:http": "node tests/http-smoke.mjs",
    "audit:publish": "node scripts/audit-publication.mjs",
    "audit:inspect": "node scripts/audit-publication.mjs --inspection",
    "build:pages": "node scripts/build-pages.mjs",
    "build:pages:guide": "node scripts/build-guide-pages.mjs",
    "build:pages:preview": "node scripts/build-pages.mjs --local-preview",
    "preview:pages": "node scripts/serve-pages.mjs",
    "test:pages": "node tests/pages-smoke.mjs",
    "test:pages:guide": "node --test tests/guide.test.mjs && node tests/pages-smoke.mjs --guide",
    "test:pages:preview": "node tests/pages-smoke.mjs --local-preview",
    "prepare:github": "node scripts/prepare-github.mjs",
    "prepare:github:review": "node scripts/prepare-github.mjs --local-review",
    "stage:github": "node scripts/stage-github.mjs",
    "stage:github:code": "node scripts/stage-github.mjs --code-only",
    "check:pages:ready": "node scripts/check-pages-inputs.mjs",
    "sync:check": "node scripts/atlas-sync.mjs --read-only",
    "sync:apply": "node scripts/atlas-sync.mjs --apply",
    "test:sync": "node --test tests/atlas-sync.test.mjs tests/sync-apply.test.mjs",
    "test:sync:apply": "node --test tests/sync-apply.test.mjs",
    "test:sync:browser": "node tests/atlas-sync-browser.mjs",
    "test:home-arena": "node --test tests/home-arena.test.mjs",
    "test:home-arena:browser": "node tests/home-arena-browser.mjs",
    "test:addon:095:browser": "node tests/addon-095-browser.mjs",
    "test:addon:095:native": "node tests/addon-095-native.mjs",
    "test:addon:pets:browser": "node tests/addon-pet-source-browser.mjs",
    "test:engine": "node --test tests/data-engine.test.mjs",
    "test:engine:browser": "node tests/data-engine-browser.mjs"
  },
  "devDependencies": {
    "acorn": "8.15.0"
  }
}
